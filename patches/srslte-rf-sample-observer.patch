+/* cellular-drones SpectrumTap: optional callback fired after every
+ * receive — lets the dashboard tap raw IQ continuously, including
+ * during pre-MIB cell search where falcon_rf_recv_wrapper is bypassed. */
+typedef void (*srslte_rf_sample_observer_t)(const void *iq, uint32_t nsamples);
+static srslte_rf_sample_observer_t g_sample_observer = (srslte_rf_sample_observer_t)0;
+void srslte_rf_set_sample_observer(srslte_rf_sample_observer_t obs) {
